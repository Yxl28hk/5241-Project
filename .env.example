# Required: Neon PostgreSQL.
# Paste Neon connection string here, keeping sslmode=require.
DATABASE_URL=
# Set a long random value for persistent sessions.
ZHIXING_SECRET_KEY=
ZHIXING_ADMIN_EMAIL=admin@zhixing.com
# Required to CREATE an administrator; existing passwords are not changed.
ZHIXING_ADMIN_PASSWORD=
PORT=5000
# Optional: separate PostgreSQL test database, never the shared application database.
# TEST_DATABASE_URL=
# Optional: complete chat-completions-compatible endpoint, secret key and model.
# Configure all three to enable real AI. Otherwise the clearly labelled guided cards remain available.
# TUTOR_API_URL=https://your-provider.example/v1/chat/completions
# TUTOR_API_KEY=
# TUTOR_MODEL=

# Teacher course drafting (Claude Messages-compatible; separate from student tutor).
# STUDIO_AI_BASE_URL=https://your-provider.example
# STUDIO_AI_API_KEY=
# STUDIO_AI_MODEL=claude-opus-4-6
# Optional local-only alternative: path to an existing Claude settings.json.
# STUDIO_AI_CONFIG_FILE=
# Use direct only if this service should bypass your machine's HTTP proxy.
# STUDIO_AI_NETWORK_MODE=system
# Keep disabled on shared deployments. Enables generation from loopback preview only.
# STUDIO_AI_LOCAL_PREVIEW=0

# Account verification/recovery: disabled until configured. Never commit credentials.
# Set a stable, random ZHIXING_SECRET_KEY shared by all application workers.
# PUBLIC_BASE_URL=https://your-school.example
MAIL_BACKEND=disabled
# MAIL_BACKEND=smtp
# MAIL_HOST=smtp.your-provider.example
# MAIL_PORT=587
# MAIL_SECURITY=starttls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@your-school.example
# Local-only testing (messages are saved to instance/mail-outbox, never emailed):
# MAIL_BACKEND=file
# PUBLIC_BASE_URL=http://127.0.0.1:5016
