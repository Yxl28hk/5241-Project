# Default: Neon PostgreSQL. For a key-free local demo: python run_demo.py
DEMO_MODE=0
# Paste Neon connection string here, keeping sslmode=require.
DATABASE_URL=
# Set a long random value for persistent sessions.
ZHIXING_SECRET_KEY=
ZHIXING_ADMIN_EMAIL=admin@zhixing.com
# Required to CREATE an administrator in PostgreSQL mode.
ZHIXING_ADMIN_PASSWORD=
PORT=5000
# Optional SQLite path (default: demo.db beside app.py).
# DEMO_DATABASE_PATH=
# The guided-demo Tutor does not call an external model and needs no API key.
