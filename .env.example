# Required: Neon PostgreSQL.
# Paste Neon connection string here, keeping sslmode=require.
DATABASE_URL=
# Set a long random value for persistent sessions.
ZHIXING_SECRET_KEY=
ZHIXING_ADMIN_EMAIL=admin@zhixing.com
# Required to CREATE an administrator; existing passwords are not changed.
ZHIXING_ADMIN_PASSWORD=
PORT=5000
# Optional: separate PostgreSQL test database, never the shared application database.
# TEST_DATABASE_URL=
# The guided-demo Tutor does not call an external model and needs no API key.
