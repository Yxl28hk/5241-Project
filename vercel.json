{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "fluid": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{frontend/**,migrations/**,app/studio/course_extract.py}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
